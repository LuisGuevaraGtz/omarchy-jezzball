[Desktop Entry]
Type=Application
Version=1.5
Name=JezzBall
GenericName=Arcade strategy game
Comment=Seal off 75 % of the arena with walls before the balls smash them. Native edition for Omarchy.
Exec=omarchy-jezzball
Icon=omarchy-jezzball
Terminal=false
Categories=Game;ArcadeGame;
StartupWMClass=omarchy-jezzball
Keywords=jezzball;arcade;game;strategy;balls;walls;omarchy;
Actions=Original;Enhanced;

# These actions rely on the `--mode <original|enhanced>` flag
# (contract docs/ARCHITECTURE.md §7). With no flag the game opens on the mode
# selector.

[Desktop Action Original]
Name=Original Mode
Name[es]=Modo Original
Exec=omarchy-jezzball --mode original

[Desktop Action Enhanced]
Name=Enhanced Mode
Name[es]=Modo Enhanced
Exec=omarchy-jezzball --mode enhanced
