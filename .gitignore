# For a Rust binary project: /target IS ignored.
# NOTE: Cargo.lock is NOT ignored. This is a final binary, so the lockfile is
# committed on purpose for reproducible builds (--locked/--frozen).

# --- Rust / Cargo ---
/target/
# rustc debug files that sometimes land in the root.
*.pdb

# --- Generic temporaries ---
*.tmp
*.bak
*~

# --- Editors and IDEs ---
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# --- Internal coordination notes ---
# (the real contracts are docs/ARCHITECTURE.md and docs/LEVEL_SCHEMA.md;
#  the .task-*.md files are working notes and are not versioned).
docs/.task-*.md

# --- Local agent / toolchain configuration ---
.hermes.md
.probe/
